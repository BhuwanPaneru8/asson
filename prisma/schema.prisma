// Asson — commerce data model
// Money is stored as integers in the smallest currency unit (paisa; Rs 1 = 100) to avoid float errors.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  // native = this machine; the others are the Linux servers we build for in CI (x86_64 and Ampere arm64)
  binaryTargets   = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  CASHIER // store POS only
  STAFF // online fulfilment
  MANAGER // approvals, stock, closing
  ADMIN // owner: everything
}

enum SalesChannel {
  ONLINE
  STORE
}

enum TenderMethod {
  CASH
  ESEWA_QR
  KHALTI_QR
  FONEPAY_QR
  CARD
  BANK
  VOUCHER // store credit / gift voucher redeemed at the till
}

enum RefundMethod {
  CASH
  ESEWA_QR
  KHALTI_QR
  FONEPAY_QR
  CARD
  BANK
  STORE_CREDIT // issues a single-use voucher code (also used for exchanges)
  EXCHANGE // online size exchange: no money back, the customer got a replacement order
}

enum ItemCondition {
  RESELLABLE // back to stock
  DAMAGED // quarantined, never sold again
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum NotificationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENDING // claimed by one dispatcher; nobody else may send it
  SENT
  FAILED
  SKIPPED // no contact detail, or channel turned off
}

enum CallOutcome {
  NONE
  CONFIRMED
  NO_ANSWER
  REJECTED
}

enum ExpenseCategory {
  RENT
  SALARIES
  UTILITIES
  MARKETING
  PACKAGING
  DELIVERY
  EQUIPMENT
  FEES
  OTHER
}

enum StoreKind {
  SHOP
  WAREHOUSE
}

enum TransferStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum Gender {
  MEN
  WOMEN
  KIDS
  UNISEX
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING // placed, awaiting confirmation / payment
  CONFIRMED // accepted by ops
  PACKED // picked & packed in warehouse
  SHIPPED // handed to courier
  OUT_FOR_DELIVERY
  /// the courier couldn't deliver and is bringing the parcel back (return to origin); ends Cancelled once received
  RETURNING
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
  IN_STORE
}

enum PaymentProvider {
  ESEWA
  KHALTI
}

enum PaymentAttemptStatus {
  INITIATED // customer sent to the provider
  COMPLETED // verified with the provider's server
  FAILED // cancelled, expired or rejected
  AMBIGUOUS // provider can't confirm yet — hold, reconcile later
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String
  phone           String?
  passwordHash    String
  role            Role          @default(CUSTOMER)
  // bump to invalidate every active session for this user
  tokenVersion    Int           @default(0)
  /// staff: what they do (lib/permissions.ts JOBS); decides which parts of the system they see. null = the classic set for their role
  job             String?
  /// staff: permissions the owner added to or removed from their job, for this person only
  permAdd         String[]      @default([])
  permRemove      String[]      @default([])
  invites         StaffInvite[]
  /// "Continue with Google": Google's stable id for this person (set on first Google sign-in)
  googleSub       String?       @unique
  /// bcrypt hash of a 4–6 digit PIN managers/owners use to approve discounts at the till
  approvalPinHash String?
  /// loyalty points balance (sum of PointsEntry.delta; kept here for atomic redemption)
  points          Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  addresses          Address[]
  orders             Order[]
  pointsEntries      PointsEntry[]
  stockAlerts        StockAlert[]
  reviews            Review[]
  wishlist           WishlistItem[]
  cart               Cart?
  /// personal referral code (made on first view of the account page)
  referralCode       String?         @unique
  /// who referred them (set on their first order with a referral code)
  referredById       String?
  /// "MM-DD"; birthday points once a year
  birthday           String?
  birthdayRewardYear Int?
  /// staff: may act at every location (HQ, owner); otherwise only at their assigned locations
  allLocations       Boolean         @default(false)
  locations          StaffLocation[]
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  rosterShifts       RosterShift[]
  absences           Absence[]       @relation("AbsencePerson")
  swapsOffered       ShiftSwap[]     @relation("SwapFrom")
  swapsReceived      ShiftSwap[]     @relation("SwapTo")
  employment         Employment?
  payslips           Payslip[]
  issuesReported     Issue[]         @relation("IssueReporter")
  issuesAssigned     Issue[]         @relation("IssueAssignee")
  careCases          CareCase[]      @relation("CareCustomer")
  careAssigned       CareCase[]      @relation("CareAssignee")

  @@index([role])
  @@index([createdAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  line1      String // house no., tole / street
  line2      String? // landmark
  city       String // municipality / city
  district   String   @default("")
  state      String // province
  postalCode String?
  country    String   @default("Nepal")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String?
  nameNe        String? // Nepali name for the storefront (blank = English shown)
  descriptionNe String?
  image         String?
  sortOrder     Int        @default(0)
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Category[] @relation("CategoryTree")
  products      Product[]

  @@index([parentId])
}

model Collection {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  nameNe        String? // Nepali name for the storefront (blank = English shown)
  descriptionNe String?
  image         String?
  featured      Boolean   @default(false)
  sortOrder     Int       @default(0)
  products      Product[]
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String
  nameNe         String? // Nepali name for the storefront (blank = English shown)
  descriptionNe  String?
  details        String[] // bullet points
  brand          String
  gender         Gender
  status         ProductStatus @default(DRAFT)
  price          Int // selling price in paise
  compareAtPrice Int? // MRP / original price in paise
  material       String?
  care           String?
  fit            String?
  tags           String[]
  featured       Boolean       @default(false)
  ratingAvg      Float         @default(0)
  ratingCount    Int           @default(0)
  soldCount      Int           @default(0)
  /// stitching (cut-make-trim) charge per piece when made in our own production, paisa
  labourCost     Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  collections      Collection[]
  images           ProductImage[]
  variants         Variant[]
  /// "Complete the look" — pieces styled with this one (chosen by the team)
  pairsWith        Product[]         @relation("CompleteTheLook")
  pairedBy         Product[]         @relation("CompleteTheLook")
  reviews          Review[]
  priceEventItems  PriceEventItem[]
  priceAlerts      PriceAlert[]
  wishlistBy       WishlistItem[]
  stats            ProductStat[]
  lookItems        LookItem[]
  bomLines         BomLine[]
  productionOrders ProductionOrder[]

  @@index([status, categoryId])
  @@index([status, gender])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, soldCount])
  @@index([brand])
  // fuzzy name search ("hodie" -> "hoodie"); full-text index lives in the search_indexes migration
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  color     String? // when set, shown for this colour variant
  position  Int     @default(0)

  @@index([productId, position])
}

/// An uploaded photo. Stored content-addressed (key = hash of the bytes) in several widths, so the same
/// photo uploaded twice is stored once and its files never change (cached forever at the CDN).
model MediaAsset {
  id           String   @id @default(cuid())
  /// "p/<32 hex>" — files live at <MEDIA_DIR>/<key>-<width>.<ext>
  key          String   @unique
  ext          String // "webp" or "jpg"
  width        Int // largest stored width
  height       Int
  bytes        Int // total bytes across all widths
  originalName String   @default("")
  uploadedById String?
  createdAt    DateTime @default(now())
}

model Variant {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String   @unique
  color             String
  colorHex          String
  size              String
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  /// weighted-average purchase cost in paisa (owner-only). Updated on every goods receipt.
  costPrice         Int?
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cartItems       CartItem[]
  orderItems      OrderItem[]
  inventoryLogs   InventoryLog[]
  purchaseItems   PurchaseOrderItem[]
  stockAlerts     StockAlert[]
  damage          DamageEntry[]
  storeStock      StoreStock[]
  allocations     OrderAllocation[]
  transferItems   StockTransferItem[]
  countLines      StockCountLine[]
  productionLines ProductionLine[]
  binAssignments  BinAssignment[]

  @@unique([productId, color, size])
  @@index([color])
  @@index([size])
  @@index([stock])
}

model InventoryLog {
  id        String   @id @default(cuid())
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String // SALE | CANCEL_RESTOCK | RETURN_RESTOCK | MANUAL_ADJUST | RECEIVED | DAMAGED | TRANSFER_OUT | TRANSFER_IN | TRANSFER_LOSS
  note      String?
  orderId   String?
  actorId   String?
  /// location whose stock changed (null on rows from before locations existed)
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  createdAt DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([storeId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id                   String           @id @default(cuid())
  number               Int              @unique @default(autoincrement())
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  email                String
  phone                String
  locale               String           @default("en") // shopper's language at checkout: SMS go out in it
  status               OrderStatus      @default(PENDING)
  paymentStatus        PaymentStatus    @default(PENDING)
  paymentMethod        PaymentMethod
  paymentProvider      PaymentProvider?
  paymentRef           String?
  /// unpaid online orders are cancelled (and restocked) after this time
  paymentDueAt         DateTime?
  subtotal             Int
  discount             Int              @default(0)
  shippingFee          Int              @default(0)
  total                Int
  couponCode           String?
  shippingMethod       String
  shippingAddress      Json
  carrier              String?
  trackingNumber       String?
  customerNote         String?
  channel              SalesChannel     @default(ONLINE)
  /// POS: who rang it up, on which shift, and who approved the discount
  cashierId            String?
  shiftId              String?
  shift                Shift?           @relation(fields: [shiftId], references: [id])
  discountReason       String?
  discountApprovedById String?
  /// idempotency key from the till so a double-tap can't create two sales
  clientRef            String?          @unique
  /// COD verification call before dispatch (fake/impulse COD orders are costly in Nepal)
  callOutcome          CallOutcome      @default(NONE)
  callAttempts         Int              @default(0)
  /// loyalty: points spent on this order (and their value) and points earned once delivered
  pointsRedeemed       Int              @default(0)
  pointsDiscount       Int              @default(0)
  pointsEarned         Int              @default(0)
  /// courier has paid us the COD collected for this order
  codRemittanceId      String?
  codRemittance        CodRemittance?   @relation(fields: [codRemittanceId], references: [id])
  /// click-and-collect: the shop the customer collects from (null = delivered by courier)
  pickupStoreId        String?
  pickupStore          Store?           @relation("PickupOrders", fields: [pickupStoreId], references: [id])
  /// taken by a shop for a customer (the size wasn't on its shelf): the shop gets the credit
  takenAtStoreId       String?
  takenAtStore         Store?           @relation("TakenAtShop", fields: [takenAtStoreId], references: [id])
  /// referral: the customer whose code gave this first order its discount, and when they were rewarded
  referrerId           String?
  referralRewardedAt   DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  items            OrderItem[]
  events           OrderEvent[]
  payments         Payment[]
  tenders          Tender[]
  returns          Return[]
  notifications    Notification[]
  allocations      OrderAllocation[]
  careCases        CareCase[]
  waveOrder        WaveOrder?
  packCheck        PackCheck?
  manifestOrder    ManifestOrder?
  deliveryAttempts DeliveryAttempt[]
  rto              ReturnToOrigin?
  exchanges        Exchange[]        @relation("ExchangeFrom")
  exchangeFor      Exchange?         @relation("ExchangeReplacement")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
  @@index([paymentStatus, paymentDueAt])
  @@index([channel, createdAt])
  @@index([shiftId])
  @@index([pickupStoreId, status])
  @@index([takenAtStoreId, createdAt])
  @@index([referrerId])
}

/// A physical shop. One today (flagship); more later.
/// A place that holds stock: a shop (has a till, can offer pickup) or a warehouse.
model Store {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  address          String
  kind             StoreKind         @default(SHOP)
  phone            String?
  /// online orders are filled from the lowest number first (ties: most lines in stock)
  priority         Int               @default(100)
  /// one of the 77 districts (province follows): online orders are filled from the nearest location first
  district         String?
  /// sends online (courier) orders; off = in-store sales and pickup only
  shipsOnline      Boolean           @default(true)
  /// click-and-collect point (shops only)
  pickup           Boolean           @default(false)
  /// opening hours shown to pickup customers, e.g. "10am – 7pm, Sun–Fri"
  hours            String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  shifts           Shift[]
  closings         DayClose[]
  stock            StoreStock[]
  inventoryLogs    InventoryLog[]
  allocations      OrderAllocation[]
  receipts         GoodsReceipt[]
  transfersOut     StockTransfer[]   @relation("TransferFrom")
  transfersIn      StockTransfer[]   @relation("TransferTo")
  pickupOrders     Order[]           @relation("PickupOrders")
  takenOrders      Order[]           @relation("TakenAtShop")
  stockCounts      StockCount[]
  staff            StaffLocation[]
  materialStock    MaterialStock[]
  materialLogs     MaterialLog[]
  productionOrders ProductionOrder[]
  attendances      Attendance[]
  commissionRules  CommissionRule[]
  checklistRuns    ChecklistRun[]
  issues           Issue[]
  careCases        CareCase[]
  vmSubmissions    VmSubmission[]
  visits           StoreVisit[]
  expenses         Expense[]
  recurringCosts   RecurringCost[]
  budgets          ShopBudget[]
  cashEntries      CashEntry[]
  deposits         BankDeposit[]
  bins             Bin[]
  pickWaves        PickWave[]
  manifests        Manifest[]
  rtoReceipts      ReturnToOrigin[]
  returns          Return[]
  rosterShifts     RosterShift[]
  rosterWeeks      RosterWeek[]
  absences         Absence[]
  damage           DamageEntry[]
  /// fewest people the roster should have on each open day
  minStaff         Int               @default(2)

  @@index([active, priority])
}

/// Units of a variant at one location. Variant.stock is kept equal to the sum of these rows by a
/// database trigger, and direct writes to Variant.stock are rejected (see lib/stock.ts).
model StoreStock {
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([storeId, variantId])
  @@index([variantId])
}

/// Where each unit of an order was taken from. Drives pick lists and puts cancelled units back
/// where they came from. Till sales are allocated (and picked) at the till's shop.
model OrderAllocation {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  quantity    Int
  pickedAt    DateTime?
  pickedById  String?
  createdAt   DateTime  @default(now())

  @@index([storeId, pickedAt])
  @@index([orderId])
}

/// Moving stock between locations: DRAFT → SENT (leaves the source) → RECEIVED (counted in).
model StockTransfer {
  id           String              @id @default(cuid())
  number       Int                 @unique @default(autoincrement())
  fromId       String
  from         Store               @relation("TransferFrom", fields: [fromId], references: [id])
  toId         String
  to           Store               @relation("TransferTo", fields: [toId], references: [id])
  status       TransferStatus      @default(DRAFT)
  note         String?
  createdById  String
  sentAt       DateTime?
  sentById     String?
  receivedAt   DateTime?
  receivedById String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        StockTransferItem[]

  @@index([status, createdAt])
  @@index([fromId, status])
  @@index([toId, status])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant       @relation(fields: [variantId], references: [id])
  quantity   Int
  /// counted at the destination; quantity − received was lost in transit
  received   Int?

  @@unique([transferId, variantId])
}

/// A cashier's session at the till, with the cash float they started with.
model Shift {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id])
  cashierId    String
  status       ShiftStatus @default(OPEN)
  openingFloat Int // paisa
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  expectedCash Int?
  countedCash  Int?
  difference   Int?
  closeNote    String?
  closedById   String?
  orders       Order[]

  @@index([storeId, status])
  @@index([cashierId, status])
  @@index([openedAt])
}

/// How a store sale was paid. A sale can be split across several tenders.
model Tender {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    TenderMethod
  amount    Int // paisa applied to the sale
  tendered  Int? // cash handed over (for change)
  reference String? // QR/card/bank transaction id
  createdAt DateTime     @default(now())

  @@index([orderId])
  @@index([method, createdAt])
}

/// Locked end-of-day record. Once locked, the day's shifts can't change.
model DayClose {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  date       String // YYYY-MM-DD in Asia/Kathmandu
  summary    Json
  note       String?
  lockedById String
  lockedAt   DateTime @default(now())

  @@unique([storeId, date])
}

/// One row per attempt to pay an order online. Never trusted until verified server-to-server.
model Payment {
  id          String               @id @default(cuid())
  orderId     String
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  status      PaymentAttemptStatus @default(INITIATED)
  amount      Int // paisa
  /// our id sent to the provider: eSewa transaction_uuid / Khalti purchase_order_id
  reference   String               @unique
  /// provider's id: Khalti pidx at initiation; transaction code once paid
  providerRef String?
  providerTxn String?
  raw         Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([orderId])
  @@index([status, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId String
  // snapshot at time of purchase — catalogue edits never rewrite history
  name      String
  slug      String
  sku       String
  color     String
  size      String
  image     String
  unitPrice Int
  quantity  Int
  /// cost of goods at the moment of sale (from Variant.costPrice) — profit never changes retroactively
  unitCost  Int?

  returnItems   ReturnItem[]
  exchangeItems ExchangeItem[]
  allocations   OrderAllocation[]

  @@index([orderId])
  @@index([productId])
}

/// A return or exchange processed at the shop (against a store or online order).
model Return {
  id            String       @id @default(cuid())
  number        Int          @unique @default(autoincrement())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id])
  shiftId       String? // set when cash left the drawer
  /// the shop the units went back to: whose closing the return belongs to
  storeId       String?
  store         Store?       @relation(fields: [storeId], references: [id])
  processedById String
  approvedById  String?
  reason        String
  refundMethod  RefundMethod
  refundAmount  Int
  voucherCode   String?
  reference     String?
  /// idempotency key from the till
  clientRef     String?      @unique
  note          String?
  createdAt     DateTime     @default(now())
  items         ReturnItem[]
  exchange      Exchange?

  @@index([orderId])
  @@index([shiftId])
  @@index([storeId, createdAt])
  @@index([createdAt])
}

model ReturnItem {
  id          String        @id @default(cuid())
  returnId    String
  return      Return        @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  quantity    Int
  condition   ItemCondition
  amount      Int // refunded for this line (after the order's discount share)

  @@index([orderItemId])
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  /// Permanent Account Number (9 digits): needed on the purchase register for input VAT
  pan              String?
  contact          String?
  phone            String?
  email            String?
  location         String?
  country          String            @default("Nepal")
  notes            String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  orders           PurchaseOrder[]
  materials        Material[]
  productionOrders ProductionOrder[] @relation("Workshop")
  bills            SupplierBill[]
  payments         SupplierPayment[]
  damageReturns    DamageEntry[]
  creditNotes      SupplierCredit[]
  /// days after the bill date that a bill falls due
  paymentTermsDays Int               @default(30)
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      Int                 @unique @default(autoincrement())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  /// freight, customs, transport — spread over items by value into landed cost
  landedCost  Int                 @default(0)
  notes       String?
  createdById String
  orderedAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]
  bills       SupplierBill[]

  @@index([status, createdAt])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          Variant       @relation(fields: [variantId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  quantityDamaged  Int           @default(0)
  unitCost         Int // supplier price per unit, paisa

  @@unique([purchaseOrderId, variantId])
}

/// One delivery from a supplier, counted and verified. Inventory goes up by what was counted.
model GoodsReceipt {
  id              String             @id @default(cuid())
  number          Int                @unique @default(autoincrement())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  receivedById    String
  /// location the counted units went into
  storeId         String?
  store           Store?             @relation(fields: [storeId], references: [id])
  note            String?
  createdAt       DateTime           @default(now())
  items           GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  receiptId      String
  receipt        GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poItemId       String
  variantId      String
  quantity       Int // good units added to stock
  damaged        Int          @default(0) // rejected at the door
  landedUnitCost Int
}

/// Outbox: every customer message is recorded first, then sent by a provider (retryable, auditable).
model Notification {
  id          String              @id @default(cuid())
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  channel     NotificationChannel
  template    String
  to          String
  body        String
  status      NotificationStatus  @default(QUEUED)
  provider    String?
  providerRef String?
  error       String?
  attempts    Int                 @default(0)
  /// when a dispatcher claimed it (SENDING); a stale claim (crash mid-send) becomes retryable
  claimedAt   DateTime?
  createdAt   DateTime            @default(now())
  sentAt      DateTime?

  @@index([status, createdAt])
  @@index([orderId])
}

/// A payout from a courier for COD it collected on our behalf.
model CodRemittance {
  id            String         @id @default(cuid())
  carrier       String
  reference     String // bank transfer / statement ref
  expected      Int // sum of COD totals of the linked orders
  received      Int // what actually arrived
  note          String?
  createdById   String
  createdAt     DateTime       @default(now())
  orders        Order[]
  statementLine StatementLine?
}

/// Append-only loyalty ledger. User.points is the running balance.
model PointsEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String // EARN | REDEEM | REDEEM_REFUND | RETURN_REVERSE | ADJUST | WELCOME
  orderId   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
}

/// "Notify me when it's back" for a sold-out size.
model StockAlert {
  id         String    @id @default(cuid())
  variantId  String
  variant    Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  phone      String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([variantId, phone])
  @@index([variantId, notifiedAt])
}

model Expense {
  id            String          @id @default(cuid())
  date          String // YYYY-MM-DD (Asia/Kathmandu)
  category      ExpenseCategory
  amount        Int
  description   String
  paidVia       String?
  /// the location this cost belongs to; null = HQ / central
  storeId       String?
  store         Store?          @relation(fields: [storeId], references: [id])
  /// what posted it automatically, e.g. "payroll:2026-11:<store>", "recurring:<id>:2026-11" (unique: never posted twice)
  source        String?         @unique
  createdById   String
  createdAt     DateTime        @default(now())
  statementLine StatementLine?

  @@index([date])
  @@index([storeId, date])
}

/// A cost that repeats every month (rent, internet, security, cleaning): posted to Expenses automatically.
model RecurringCost {
  id          String          @id @default(cuid())
  storeId     String?
  store       Store?          @relation(fields: [storeId], references: [id])
  category    ExpenseCategory
  amount      Int
  description String
  /// YYYY-MM: first and (optionally) last month it applies to
  startMonth  String
  endMonth    String?
  active      Boolean         @default(true)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus?
  message   String
  actor     String // "system" | "customer" | staff email
  createdAt DateTime     @default(now())

  @@index([orderId, createdAt])
}

/// Delivery pricing per district — edited by the owner in Admin → Delivery.
model DeliveryRate {
  district         String   @id
  province         String
  zone             String // VALLEY | OUTSIDE | REMOTE — grouping/defaults only
  fee              Int // standard delivery, paisa
  etaMinDays       Int
  etaMaxDays       Int
  expressAvailable Boolean  @default(false)
  codAvailable     Boolean  @default(true)
  serviceable      Boolean  @default(true)
  updatedById      String?
  updatedAt        DateTime @updatedAt

  @@index([province])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType
  /// store credit (from a return): `value` is the remaining balance, drawn down on each use
  isCredit    Boolean    @default(false)
  value       Int // percent (0-100) or paise
  minSubtotal Int        @default(0)
  maxDiscount Int? // cap for percent coupons, paise
  usageLimit  Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean    @default(true)
  /// featured in the home-page offer banner (at most one at a time)
  showOnHome  Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String
  body      String
  fit       String? // "Runs small" | "True to size" | "Runs large"
  verified  Boolean      @default(false)
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
}

/// Who changed what, when, from where. APPEND-ONLY: a database trigger rejects UPDATE and DELETE
/// (see migration 20261110120000_audit_log). No foreign key to User, so history survives account removal.
model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  /// snapshot at the time (names and roles change)
  actorName  String   @default("")
  actorRole  String   @default("")
  /// dotted verb, e.g. "product.update", "user.role", "auth.login_failed"
  action     String
  entityType String
  entityId   String?
  /// one human-readable line, e.g. "Price Rs. 2,499 → Rs. 2,299"
  summary    String
  /// { field: [before, after] } or other structured detail
  changes    Json?
  ip         String?

  @@index([at])
  @@index([entityType, entityId, at])
  @@index([actorId, at])
  @@index([action, at])
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  DEAD
}

/// Background work, run by the in-process worker (lib/jobs.ts). Claimed with FOR UPDATE SKIP LOCKED,
/// retried with backoff, and parked as DEAD after maxAttempts so a human can look.
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json      @default("{}")
  /// idempotency: enqueueing the same key twice is a no-op (recurring slots use type@slot)
  key         String?   @unique
  status      JobStatus @default(QUEUED)
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([status, runAt])
  @@index([type, createdAt])
}

/// Errors grouped by fingerprint (where + normalised message). Never holds request bodies,
/// headers, query strings or personal data.
model ErrorEvent {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  source      String // server | action | job | client
  where       String
  message     String
  stack       String?
  digest      String?
  context     Json?
  count       Int       @default(1)
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([resolvedAt, lastSeen])
}

/// Storefront searches, one row per Nepal day and normalised term (no per-visitor data).
model SearchStat {
  day         String // YYYY-MM-DD in Asia/Kathmandu
  term        String
  searches    Int    @default(0)
  zeroResults Int    @default(0)
  lastResults Int    @default(0)

  @@id([day, term])
  @@index([term])
}

enum StockCountStatus {
  COUNTING
  SUBMITTED
  APPROVED
  CANCELLED
}

/// A physical count at one location (whole location or one category). Counting is blind; the
/// system figure is captured per line at the moment it's counted, so sales can go on meanwhile.
model StockCount {
  id            String           @id @default(cuid())
  number        Int              @unique @default(autoincrement())
  storeId       String
  store         Store            @relation(fields: [storeId], references: [id])
  /// null = whole location
  categoryId    String?
  scopeLabel    String
  status        StockCountStatus @default(COUNTING)
  note          String?
  createdById   String
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lines         StockCountLine[]

  @@index([storeId, status])
  @@index([status, createdAt])
}

model StockCountLine {
  id          String     @id @default(cuid())
  countId     String
  count       StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// physical units counted (null = not counted yet; left unchanged on approval)
  counted     Int?
  /// system units at this location when the line was last counted
  systemAt    Int?
  countedAt   DateTime?
  countedById String?
  /// found during the count, not in the original list
  added       Boolean    @default(false)

  @@unique([countId, variantId])
}

enum BillStatus {
  OPEN
  PAID
  VOID
}

enum SupplierPayMethod {
  CASH
  BANK
  CHEQUE
  ESEWA
  KHALTI
  FONEPAY
}

/// A supplier's invoice: what we owe them. Never deleted; mistakes are voided with a reason.
model SupplierBill {
  id                String              @id @default(cuid())
  number            Int                 @unique @default(autoincrement())
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  /// the supplier's own invoice number
  reference         String
  billDate          DateTime
  dueDate           DateTime
  /// total payable in paisa, VAT included
  amount            Int
  /// VAT part of `amount` (input VAT for the VAT return)
  vatAmount         Int                 @default(0)
  /// sum of live payment allocations, kept in step in each transaction (CHECK 0 <= paid <= amount)
  paid              Int                 @default(0)
  status            BillStatus          @default(OPEN)
  note              String?
  voidReason        String?
  createdById       String
  createdAt         DateTime            @default(now())
  allocations       PaymentAllocation[]
  creditAllocations CreditAllocation[]

  @@unique([supplierId, reference])
  @@index([status, dueDate])
  @@index([supplierId, billDate])
}

/// Money paid to a supplier. Whatever isn't allocated to bills is credit for later bills.
model SupplierPayment {
  id            String              @id @default(cuid())
  number        Int                 @unique @default(autoincrement())
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  amount        Int
  /// not yet allocated to a bill = supplier credit (CHECK 0 <= unallocated <= amount)
  unallocated   Int
  method        SupplierPayMethod
  reference     String?
  paidAt        DateTime
  note          String?
  voidedAt      DateTime?
  voidReason    String?
  createdById   String
  createdAt     DateTime            @default(now())
  allocations   PaymentAllocation[]
  statementLine StatementLine?

  @@index([supplierId, paidAt])
}

model PaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id])
  billId    String
  bill      SupplierBill    @relation(fields: [billId], references: [id])
  amount    Int
  createdAt DateTime        @default(now())

  @@unique([paymentId, billId])
  @@index([billId])
}

/// Shop funnel counters per Nepal day (product views, add to bag, checkout visits). No per-visitor data;
/// known bots are not counted. Orders come from the Order table.
model FunnelStat {
  day   String // YYYY-MM-DD in Asia/Kathmandu
  step  String // view | add | checkout
  count Int    @default(0)

  @@id([day, step])
}

/// Per-product views and adds to bag per Nepal day.
model ProductStat {
  day       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  views     Int     @default(0)
  adds      Int     @default(0)

  @@id([day, productId])
  @@index([productId])
}

/// Lookbook: a styled outfit or mood built only from Asson's own products.
model Look {
  id        String     @id @default(cuid())
  slug      String     @unique
  title     String
  /// one line under the title, e.g. "Linen, sandals and a late lunch by Phewa"
  subtitle  String?
  /// a short paragraph about the look (plain text)
  story     String?
  /// hero photo (uploaded media or an https link); falls back to the first piece's photo
  heroImage String?
  published Boolean    @default(false)
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     LookItem[]

  @@index([published, position])
}

model LookItem {
  id        String  @id @default(cuid())
  lookId    String
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)
  /// styling tip shown with the piece, e.g. "Sleeves rolled twice"
  note      String?

  @@unique([lookId, productId])
  @@index([productId])
}

/// Which locations a staff member works at (tills, stock, transfers, counts, picking).
model StaffLocation {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, storeId])
  @@index([storeId])
}

/// Something in the system that went wrong and (maybe) recovered: opened and closed by the watchdog
/// (lib/health.ts, every 5 minutes). Doubles as the uptime history on Admin → System.
model Incident {
  id              String    @id @default(cuid())
  check           String // health check key, e.g. "backups", "worker"
  critical        Boolean // critical ones text the owner (ALERT_PHONES)
  detail          String
  startedAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?
  alertedAt       DateTime?
  recoveryAlertAt DateTime?

  @@index([check, resolvedAt])
  @@index([startedAt])
}

// ---------- Own production (Phase 11.8) ----------
// Fabric and trims are stocked per location like finished goods; quantities in milli-units (1 m = 1000) so
// fractions of a metre stay exact. A product's bill of materials says what one piece uses; a production
// order issues those materials to a workshop and receives finished pieces back, costed and billed.

enum MaterialKind {
  FABRIC
  TRIM
  PACKAGING
}

model Material {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  kind        MaterialKind
  /// unit of measure shown to people: m, pcs, kg, cone…
  unit        String
  color       String?
  supplierId  String?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  /// weighted-average cost per whole unit, paisa (blended at every receipt)
  costPerUnit Int?
  /// reorder level, milli-units across all locations
  minStock    Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  stock       MaterialStock[]
  logs        MaterialLog[]
  bomLines    BomLine[]
}

model MaterialStock {
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  /// milli-units (CHECK >= 0)
  quantity   Int      @default(0)
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([storeId, materialId])
  @@index([materialId])
}

/// Every change to material stock, with why (RECEIVED, ISSUED, RETURNED, ADJUST).
model MaterialLog {
  id                String           @id @default(cuid())
  materialId        String
  material          Material         @relation(fields: [materialId], references: [id])
  storeId           String
  store             Store            @relation(fields: [storeId], references: [id])
  /// milli-units, + in / − out
  delta             Int
  reason            String
  /// paisa per whole unit at the time
  unitCost          Int?
  note              String?
  supplierId        String?
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  actorId           String?
  createdAt         DateTime         @default(now())

  @@index([materialId, createdAt])
  @@index([storeId, createdAt])
  @@index([productionOrderId])
}

/// What one finished piece of a product uses (milli-units per piece).
model BomLine {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Int
  note       String?

  @@unique([productId, materialId])
}

enum ProductionStatus {
  DRAFT
  ISSUED
  PARTIAL
  COMPLETED
  CANCELLED
}

model ProductionOrder {
  id             String              @id @default(cuid())
  number         Int                 @unique @default(autoincrement())
  productId      String
  product        Product             @relation(fields: [productId], references: [id])
  /// the workshop (a supplier) that cuts and stitches
  workshopId     String
  workshop       Supplier            @relation("Workshop", fields: [workshopId], references: [id])
  /// materials are issued from, and finished pieces received into, this location
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id])
  status         ProductionStatus    @default(DRAFT)
  /// stitching charge per good piece, paisa (billed to us by the workshop)
  labourPerPiece Int                 @default(0)
  /// cost of the materials issued so far, paisa
  materialsCost  Int                 @default(0)
  dueDate        DateTime?
  note           String?
  createdById    String
  createdAt      DateTime            @default(now())
  issuedAt       DateTime?
  completedAt    DateTime?
  lines          ProductionLine[]
  receipts       ProductionReceipt[]
  materialLogs   MaterialLog[]

  @@index([status, createdAt])
}

model ProductionLine {
  id        String          @id @default(cuid())
  orderId   String
  order     ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant         @relation(fields: [variantId], references: [id])
  planned   Int
  /// good pieces taken into stock
  received  Int             @default(0)
  /// pieces the quality check turned away
  rejected  Int             @default(0)

  @@unique([orderId, variantId])
}

/// One delivery of finished pieces from the workshop.
model ProductionReceipt {
  id           String          @id @default(cuid())
  number       Int             @unique @default(autoincrement())
  orderId      String
  order        ProductionOrder @relation(fields: [orderId], references: [id])
  good         Int
  rejected     Int
  /// cost per good piece used for stock valuation (materials per planned piece + labour), paisa
  unitCost     Int
  labourAmount Int
  billId       String?
  createdById  String
  createdAt    DateTime        @default(now())
}

// ---------- People: attendance and leave (Phase 12a) ----------

/// One stretch of work at a location: clock in → clock out (open while clockOut is null; one open per person).
model Attendance {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id])
  clockIn    DateTime
  clockOut   DateTime?
  /// forgot to clock out: closed by the system at zero length, a manager must fix it
  autoClosed Boolean   @default(false)
  note       String?
  editedById String?
  editReason String?
  createdAt  DateTime  @default(now())

  @@index([userId, clockIn])
  @@index([storeId, clockIn])
  @@index([clockOut])
}

/// A published shift with no clock-in (found by the hourly job), for a manager to decide. UNPAID takes a day's pay
/// in that month's payroll; LEAVE books it as approved leave (from the person's balance); WORKED means they were
/// there and forgot to clock in (an attendance entry is added for the shift). Payroll won't approve a month with
/// OPEN absences in it.
model Absence {
  id             String        @id @default(cuid())
  /// the shift that was missed (kept even if the shift is later removed from the roster)
  shiftId        String?       @unique
  shift          RosterShift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  userId         String
  user           User          @relation("AbsencePerson", fields: [userId], references: [id])
  storeId        String
  store          Store         @relation(fields: [storeId], references: [id])
  /// Nepal calendar date YYYY-MM-DD, and the shift's times "HH:MM"
  date           String
  start          String
  end            String
  status         AbsenceStatus @default(OPEN)
  leaveRequestId String?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
  decidedById    String?
  decidedAt      DateTime?
  note           String?
  createdAt      DateTime      @default(now())

  @@index([status, date])
  @@index([userId, date])
  @@index([storeId, status])
}

enum AbsenceStatus {
  OPEN
  UNPAID
  LEAVE
  WORKED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  number       Int         @unique @default(autoincrement())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  /// leave type key from store.people.leave (HOME, SICK, …)
  type         String
  /// Nepal calendar dates, inclusive (YYYY-MM-DD)
  fromDate     String
  toDate       String
  /// working days in the range (weekly day off not counted)
  days         Int
  reason       String?
  status       LeaveStatus @default(PENDING)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())
  absences     Absence[]

  @@index([userId, fromDate])
  @@index([status, createdAt])
}

// ---------- People: payroll (Phase 12b) ----------

/// Salary terms for a staff member (monthly, paisa). Owner-only.
model Employment {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  basic       Int
  /// dearness and other fixed allowances per month
  allowance   Int      @default(0)
  inSsf       Boolean  @default(true)
  /// tax bands: married couples have their own
  married     Boolean  @default(false)
  pan         String?
  bankAccount String?
  joinedOn    String?
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Income-tax bands for one Nepal fiscal year (e.g. "2083/84"). Payroll refuses to run until confirmed.
model PayrollTaxYear {
  id               String    @id @default(cuid())
  fiscalYear       String    @unique
  /// [{ upTo: rupees | null, rate: percent }]
  single           Json
  married          Json
  ssfFirstBandZero Boolean   @default(true)
  confirmedById    String?
  confirmedAt      DateTime?
  source           String?
  updatedAt        DateTime  @updatedAt
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollRun {
  id           String             @id @default(cuid())
  /// Gregorian month YYYY-MM (the timesheet month)
  month        String             @unique
  fiscalYear   String
  status       PayrollStatus      @default(DRAFT)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime           @default(now())
  slips        Payslip[]
  deposits     StatutoryDeposit[]
}

/// One person's pay for one month. Recomputed while the run is a draft; frozen once approved.
model Payslip {
  id              String     @id @default(cuid())
  runId           String
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  basic           Int
  allowance       Int
  bonus           Int        @default(0)
  /// till sales commission for the month (taxable, part of gross)
  commission      Int        @default(0)
  workingDays     Int
  daysWorked      Int
  leaveDays       Int
  unpaidDays      Int
  /// extra unpaid days the owner added (absences not on the timesheet)
  extraUnpaidDays Int        @default(0)
  /// no-shows a manager decided were unpaid (Absence UNPAID in the month); part of unpaidDays
  absenceDays     Int        @default(0)
  /// year-end settlement (the fiscal year's last month only): TDS changed by this much from the monthly method,
  /// the year's actual tax, and TDS deducted beyond it (refundable by the IRD)
  taxAdjustment   Int        @default(0)
  yearTax         Int?
  taxRefundDue    Int        @default(0)
  inSsf           Boolean
  married         Boolean
  earnedBasic     Int
  unpaidDeduction Int
  gross           Int
  ssfEmployee     Int
  ssfEmployer     Int
  incomeTax       Int
  net             Int
  note            String?

  @@unique([runId, userId])
}

/// Sales commission for till staff: rate (basis points: 100 = 1%) on their sales excluding VAT, net of
/// refunds, once the month's sales at that shop reach the threshold. storeId null = every shop without its own.
model CommissionRule {
  id        String   @id @default(cuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])
  rateBp    Int
  threshold Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ---------- Shop operations hub (Phase 13a) ----------

/// A message from HQ to all locations or chosen ones; staff confirm they've read it when it matters.
model Announcement {
  id          String             @id @default(cuid())
  title       String
  body        String
  /// empty = every location
  storeIds    String[]
  requiresAck Boolean            @default(true)
  createdById String
  createdAt   DateTime           @default(now())
  expiresAt   DateTime?
  reads       AnnouncementRead[]

  @@index([createdAt])
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}

/// A daily checklist HQ defines (opening, closing, cleaning…) for shops, warehouses or both.
model ChecklistTemplate {
  id        String         @id @default(cuid())
  name      String
  /// [{ text }]
  items     Json
  /// SHOP, WAREHOUSE or null for every location
  kind      StoreKind?
  /// "HH:mm" Nepal time it should be done by (shown and used for "late")
  dueBy     String?
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  runs      ChecklistRun[]
}

/// One location's checklist for one Nepal day. Items ticked one by one, by whoever does them.
model ChecklistRun {
  id          String            @id @default(cuid())
  templateId  String
  template    ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id])
  /// Nepal date YYYY-MM-DD
  date        String
  /// [{ text, doneById, doneByName, doneAt }] — a snapshot of the template's items for that day
  items       Json
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  @@unique([templateId, storeId, date])
  @@index([storeId, date])
}

enum IssueCategory {
  EQUIPMENT // till, printer, scanner, rails, mirrors
  BUILDING // lights, AC, shutter, water, leaks
  IT // internet, phone, POS app
  SAFETY // fire, theft, injury
  STOCK // damaged delivery, wrong items
  OTHER
}

enum IssuePriority {
  LOW
  NORMAL
  URGENT
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD // waiting for a part, landlord, supplier
  RESOLVED
}

/// A problem a location reports to HQ (broken equipment, maintenance, safety). Has a due time from its
/// priority, an assignee, and a timeline. Only people at the location or with ops.manage over it see it.
model Issue {
  id          String        @id @default(cuid())
  number      Int           @unique @default(autoincrement())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id])
  category    IssueCategory
  priority    IssuePriority @default(NORMAL)
  status      IssueStatus   @default(OPEN)
  title       String
  description String
  photos      String[]
  createdById String
  createdBy   User          @relation("IssueReporter", fields: [createdById], references: [id])
  assigneeId  String?
  assignee    User?         @relation("IssueAssignee", fields: [assigneeId], references: [id])
  dueAt       DateTime
  respondedAt DateTime? // first action by someone other than the reporter
  resolvedAt  DateTime?
  escalatedAt DateTime? // passed its due time while still open
  /// what the repair cost, paisa (recorded here; post it in Finance → Expenses)
  cost        Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  events      IssueEvent[]

  @@index([status, dueAt])
  @@index([storeId, createdAt])
  @@index([assigneeId, status])
}

model IssueEvent {
  id        String       @id @default(cuid())
  issueId   String
  issue     Issue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  byId      String?
  byName    String
  /// set when the status changed
  status    IssueStatus?
  message   String
  photos    String[]
  createdAt DateTime     @default(now())

  @@index([issueId, createdAt])
}

enum CareChannel {
  WEB // the contact form on Help or an order page
  PHONE
  WHATSAPP
  SHOP // told a shop in person
  EMAIL
  SOCIAL // Facebook, Instagram, TikTok
}

enum CareCategory {
  ORDER // where is it, wrong or missing item
  DELIVERY // late, courier problem
  PAYMENT // charged twice, refund not received
  QUALITY // faulty, damaged, colour ran
  EXCHANGE // size or exchange
  SERVICE // complaint about a shop or staff
  OTHER
}

enum CareStatus {
  NEW // nobody has replied yet
  OPEN // we're working on it
  WAITING // waiting for the customer
  RESOLVED
}

/// One customer problem, from any channel, in one queue. Customers follow it at /help/case/<token>.
model CareCase {
  id             String        @id @default(cuid())
  number         Int           @unique @default(autoincrement())
  /// secret for the customer's page (no sign-in needed)
  token          String        @unique
  channel        CareChannel
  category       CareCategory
  priority       IssuePriority @default(NORMAL)
  status         CareStatus    @default(NEW)
  subject        String
  name           String
  phone          String?
  email          String?
  locale         String        @default("en")
  userId         String?
  user           User?         @relation("CareCustomer", fields: [userId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// the shop it's about (its manager sees it); null = online / HQ
  storeId        String?
  store          Store?        @relation(fields: [storeId], references: [id])
  assigneeId     String?
  assignee       User?         @relation("CareAssignee", fields: [assigneeId], references: [id])
  createdById    String? // staff who logged a phone/shop case
  /// when we owe the customer a reply by (set when they write, cleared when we reply)
  respondBy      DateTime?
  firstReplyAt   DateTime?
  lastCustomerAt DateTime      @default(now())
  resolvedAt     DateTime?
  /// the customer's rating after it was resolved: 1–5, optional comment
  rating         Int?
  ratingComment  String        @default("")
  ratedAt        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       CareMessage[]

  @@index([status, respondBy])
  @@index([phone])
  @@index([userId])
  @@index([orderId])
  @@index([storeId, createdAt])
}

enum CareMessageKind {
  CUSTOMER // from the customer
  REPLY // from us, shown to the customer
  NOTE // staff only
}

model CareMessage {
  id        String          @id @default(cuid())
  caseId    String
  case      CareCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind      CareMessageKind
  body      String
  byId      String?
  byName    String
  createdAt DateTime        @default(now())

  @@index([caseId, createdAt])
}

enum VmStatus {
  SUBMITTED // waiting for review
  APPROVED
  REDO // reviewer asked for changes
}

/// A visual-merchandising brief from HQ: how a window or display must look, by when, at which shops.
model VmBrief {
  id           String         @id @default(cuid())
  number       Int            @unique @default(autoincrement())
  title        String
  instructions String
  /// how it should look
  refPhotos    String[]
  /// [{ name, hint }]: the shots each shop must send, e.g. Window, Entrance table
  areas        Json
  /// [{ text }]: what the reviewer scores 0–2 each
  criteria     Json
  /// empty = every shop
  storeIds     String[]
  dueAt        DateTime
  closedAt     DateTime?
  createdById  String
  createdAt    DateTime       @default(now())
  submissions  VmSubmission[]

  @@index([createdAt])
}

/// One shop's answer to a brief. Resubmitting after a redo starts a new round.
model VmSubmission {
  id            String    @id @default(cuid())
  briefId       String
  brief         VmBrief   @relation(fields: [briefId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  status        VmStatus
  round         Int       @default(1)
  /// [{ area, url }]
  photos        Json
  note          String    @default("")
  submittedById String
  submittedAt   DateTime
  reviewedById  String?
  reviewedAt    DateTime?
  feedback      String    @default("")
  /// one score 0–2 per criterion, and the total as a percentage
  scores        Int[]
  score         Int?
  events        VmEvent[]

  @@unique([briefId, storeId])
  @@index([storeId, reviewedAt])
}

model VmEvent {
  id           String       @id @default(cuid())
  submissionId String
  submission   VmSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  round        Int
  status       VmStatus
  message      String
  byId         String
  byName       String
  createdAt    DateTime     @default(now())

  @@index([submissionId, createdAt])
}

/// What an area manager checks on a store visit: sections of yes/no items, some critical.
model VisitTemplate {
  id        String       @id @default(cuid())
  name      String
  /// [{ name, items: [{ text, critical? }] }]
  sections  Json
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  visits    StoreVisit[]
}

enum VisitStatus {
  DRAFT // being filled in during the walk-through
  SUBMITTED // done; waiting for the shop to acknowledge
  ACKNOWLEDGED // the shop has read it
}

/// One walk-through of a shop. Items are a snapshot of the template, so editing it never rewrites old visits.
model StoreVisit {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  templateId    String
  template      VisitTemplate @relation(fields: [templateId], references: [id])
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  auditorId     String
  auditorName   String
  status        VisitStatus   @default(DRAFT)
  /// [{ section, text, critical, result?: PASS|FAIL|NA, note?, photos? }]
  items         Json
  summary       String        @default("")
  score         Int?
  criticalFails Int           @default(0)
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  ackById       String?
  ackByName     String?
  ackAt         DateTime?
  ackNote       String        @default("")
  actions       VisitAction[]

  @@index([storeId, submittedAt])
  @@index([status])
}

enum VisitActionStatus {
  OPEN
  DONE // the shop says it's fixed
  VERIFIED // the auditor or HQ agrees
}

/// A failed item from a visit that the shop must fix by a date.
model VisitAction {
  id         String            @id @default(cuid())
  visitId    String
  visit      StoreVisit        @relation(fields: [visitId], references: [id], onDelete: Cascade)
  storeId    String
  itemIndex  Int
  text       String
  note       String            @default("")
  critical   Boolean           @default(false)
  dueAt      DateTime
  status     VisitActionStatus @default(OPEN)
  doneById   String?
  doneByName String?
  doneAt     DateTime?
  doneNote   String            @default("")
  donePhotos String[]
  verifiedAt DateTime?
  createdAt  DateTime          @default(now())

  @@unique([visitId, itemIndex])
  @@index([storeId, status, dueAt])
}

/// A location's plan for one month: the sales target and what it may spend. Set by the owner.
model ShopBudget {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  /// YYYY-MM
  month       String
  /// paisa, same basis as the P&L (net sales incl. VAT)
  sales       Int
  /// target gross margin, tenths of a percent (e.g. 520 = 52.0%); null = no target
  marginPm    Int?
  /// paisa: staff, rent and everything else the location may spend
  costs       Int      @default(0)
  note        String   @default("")
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeId, month])
  @@index([month])
}

enum CashKind {
  OPENING // the safe's balance when the cash book started
  FLOAT_OUT // a till float taken out of the safe when a shift opened
  SHIFT_IN // a closed shift's counted cash put into the safe
  DEPOSIT // taken to the bank
  DEPOSIT_FIX // a deposit the bank didn't confirm (or confirmed for a different amount): put back
  PETTY // spent from the safe (also an expense)
  COUNT // a safe count found a difference
}

/// The cash book of one location's safe. Append-only: every movement is an entry; the balance is the sum.
model CashEntry {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  kind      CashKind
  /// paisa, + into the safe, − out of it
  amount    Int
  note      String   @default("")
  /// what posted it, e.g. "shift-open:<id>", "deposit:<id>" (unique: posted once)
  source    String?  @unique
  byId      String
  byName    String
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

enum DepositStatus {
  RECORDED // the shop says it's at the bank
  VERIFIED // finance has seen it on the bank statement
  DISPUTED // the bank shows a different amount (or nothing): the difference went back into the cash book
}

model BankDeposit {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id])
  amount        Int
  bank          String
  slipNo        String
  slipPhoto     String?
  depositedOn   String // YYYY-MM-DD
  status        DepositStatus  @default(RECORDED)
  /// what the bank statement showed (for disputes)
  bankAmount    Int?
  checkNote     String         @default("")
  byId          String
  byName        String
  checkedById   String?
  checkedAt     DateTime?
  createdAt     DateTime       @default(now())
  statementLine StatementLine?

  @@unique([bank, slipNo])
  @@index([storeId, status])
}

enum StatementLineStatus {
  UNMATCHED // a line we haven't explained yet (credit or debit)
  MATCHED // tied to a shop deposit, courier COD remittance, supplier payment or expense
  IGNORED // explained in words (interest, wallet settlement, salary batch, owner top-up)
  DEBIT // retired: debits are matched like credits now (kept so old values stay valid)
}

/// One line of an imported bank statement. Importing the same file twice adds nothing (the key is unique).
model StatementLine {
  id           String              @id @default(cuid())
  /// the account name finance typed when importing, e.g. "NIC Asia current"
  account      String
  date         String // YYYY-MM-DD
  /// paisa: + credit, − debit
  amount       Int
  description  String
  reference    String              @default("")
  /// account + date + amount + description + reference + nth identical line in that file
  key          String              @unique
  status       StatementLineStatus
  depositId    String?             @unique
  deposit      BankDeposit?        @relation(fields: [depositId], references: [id])
  remittanceId String?             @unique
  remittance   CodRemittance?      @relation(fields: [remittanceId], references: [id])
  paymentId    String?             @unique
  payment      SupplierPayment?    @relation(fields: [paymentId], references: [id])
  expenseId    String?             @unique
  expense      Expense?            @relation(fields: [expenseId], references: [id])
  vatReturnId  String?             @unique
  vatReturn    VatReturn?          @relation(fields: [vatReturnId], references: [id])
  statutoryId  String?             @unique
  statutory    StatutoryDeposit?   @relation(fields: [statutoryId], references: [id])
  note         String              @default("")
  matchedById  String?
  matchedAt    DateTime?
  importedById String
  importedAt   DateTime            @default(now())

  @@index([account, date])
  @@index([status])
}

/// A month whose books are closed: nothing dated in it can be added or changed until the owner reopens it.
model MonthClose {
  id           String    @id @default(cuid())
  /// YYYY-MM
  month        String    @unique
  closedAt     DateTime?
  closedById   String?
  closedByName String?
  /// the checklist and P&L as they stood when it was closed
  snapshot     Json
  reopenedAt   DateTime?
  reopenReason String    @default("")
  /// times it has been closed (a reopen + close counts again)
  closes       Int       @default(1)
  updatedAt    DateTime  @updatedAt
}

enum VatReturnStatus {
  DRAFT
  FILED // submitted to IRD: its period's purchase bills are locked
}

/// One VAT return. The period is the Nepali month the accountant files for, as AD dates (from–to, both included).
model VatReturn {
  id             String          @id @default(cuid())
  /// e.g. "Kartik 2083"
  label          String
  from           String // YYYY-MM-DD
  to             String
  status         VatReturnStatus @default(DRAFT)
  /// the figures as filed (paisa): output VAT on sales less returns, claimable input VAT, credit brought forward
  outputVat      Int             @default(0)
  inputVat       Int             @default(0)
  unclaimableVat Int             @default(0)
  broughtForward Int             @default(0)
  payable        Int             @default(0)
  carryForward   Int             @default(0)
  snapshot       Json?
  ackNo          String?
  filedAt        DateTime?
  filedById      String?
  paidOn         String?
  paidAmount     Int?
  paidRef        String?
  reopenReason   String          @default("")
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  statementLine  StatementLine?

  @@index([from, to])
}

enum StatutoryKind {
  TDS // income tax withheld from salaries, deposited with the IRD
  SSF // employee 11% + employer 20%, deposited with the Social Security Fund
}

/// What a paid payroll owes the IRD or the SSF, and when it was deposited.
model StatutoryDeposit {
  id            String         @id @default(cuid())
  runId         String
  run           PayrollRun     @relation(fields: [runId], references: [id])
  kind          StatutoryKind
  /// paisa, from the payslips
  amount        Int
  /// YYYY-MM-DD: 25 days after the payroll month ends
  dueOn         String
  paidOn        String?
  paidAmount    Int?
  reference     String?
  paidById      String?
  createdAt     DateTime       @default(now())
  statementLine StatementLine?

  @@unique([runId, kind])
  @@index([paidOn])
}

/// A fiscal year (Shrawan–Ashadh) signed off by the owner, with the year's figures as they stood.
model FiscalYearClose {
  id           String    @id @default(cuid())
  /// e.g. "2083/84"
  label        String    @unique
  from         String // YYYY-MM-DD (AD date of Shrawan 1)
  to           String // YYYY-MM-DD (AD date of the last day of Ashadh)
  closedAt     DateTime?
  closedById   String?
  closedByName String?
  snapshot     Json?
  reopenedAt   DateTime?
  reopenReason String    @default("")
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A shelf position at a location, e.g. A-03-2 (zone A, aisle 3, shelf 2). Pick lists walk bins in `sortKey` order.
model Bin {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id])
  code        String
  /// the code with numbers zero-padded, so A-2 sorts before A-10
  sortKey     String
  zone        String          @default("")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  assignments BinAssignment[]

  @@unique([storeId, code])
  @@index([storeId, sortKey])
}

/// The home bin of one size at one location: where it's put away and picked from.
model BinAssignment {
  storeId      String
  variantId    String
  variant      Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  binId        String
  bin          Bin      @relation(fields: [binId], references: [id])
  assignedById String
  updatedAt    DateTime @updatedAt

  @@id([storeId, variantId])
  @@index([binId])
}

enum WaveStatus {
  OPEN // being picked
  PICKED // every unit collected into its slot
  CANCELLED
}

/// A batch of orders picked in one walk at one location; each order gets a slot (tote or shelf number).
model PickWave {
  id          String      @id @default(cuid())
  number      Int         @unique @default(autoincrement())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id])
  status      WaveStatus  @default(OPEN)
  createdById String
  createdAt   DateTime    @default(now())
  pickedById  String?
  pickedAt    DateTime?
  orders      WaveOrder[]

  @@index([storeId, status])
}

model WaveOrder {
  waveId  String
  wave    PickWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  orderId String   @unique // an order is in one wave at a time (rows are removed if the wave is cancelled)
  order   Order    @relation(fields: [orderId], references: [id])
  slot    Int

  @@id([waveId, orderId])
  @@unique([waveId, slot])
}

/// What the packer scanned before an order was packed (and any override, with its reason).
model PackCheck {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  storeId     String?
  /// [{ sku, quantity }]
  scans       Json
  matched     Boolean
  override    String   @default("")
  weightGrams Int?
  box         String?
  packedById  String
  createdAt   DateTime @default(now())
}

enum ManifestStatus {
  OPEN // parcels being scanned on
  HANDED_OVER // the rider signed for them; the orders are shipped
  CANCELLED
}

/// The parcels one courier collects from one location in one pickup. Handing over ships every order on it at once.
model Manifest {
  id          String          @id @default(cuid())
  number      Int             @unique @default(autoincrement())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id])
  carrier     String
  status      ManifestStatus  @default(OPEN)
  createdById String
  createdAt   DateTime        @default(now())
  /// filled at hand-over
  riderName   String?
  riderPhone  String?
  handedAt    DateTime?
  handedById  String?
  parcels     Int?
  codTotal    Int?
  orders      ManifestOrder[]

  @@index([storeId, status])
}

model ManifestOrder {
  manifestId     String
  manifest       Manifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  orderId        String   @unique // one manifest per parcel (rows are removed if the manifest is cancelled)
  order          Order    @relation(fields: [orderId], references: [id])
  trackingNumber String
  /// cash the rider collects at the door (COD total, 0 if prepaid)
  cod            Int
  addedById      String
  addedAt        DateTime @default(now())

  @@id([manifestId, orderId])
}

enum DeliveryFailReason {
  CUSTOMER_REFUSED
  NOT_REACHABLE // phone off or not answering
  NOT_HOME
  WRONG_ADDRESS
  COD_NOT_READY // customer didn't have the cash
  RESCHEDULED // customer asked for another day
  OTHER
}

/// A failed delivery attempt, as reported by the courier.
model DeliveryAttempt {
  id           String             @id @default(cuid())
  orderId      String
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason       DeliveryFailReason
  note         String             @default("")
  recordedById String
  createdAt    DateTime           @default(now())

  @@index([orderId])
  @@index([createdAt])
}

enum RtoState {
  IN_TRANSIT // the courier is bringing it back
  RECEIVED // back at one of our locations
  LOST // the courier lost it: we claim the goods' value
}

/// A parcel coming back undelivered (return to origin), and how it came back.
model ReturnToOrigin {
  orderId       String             @id
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason        DeliveryFailReason
  carrier       String
  startedAt     DateTime           @default(now())
  startedById   String
  state         RtoState           @default(IN_TRANSIT)
  /// receipt
  storeId       String?
  store         Store?             @relation(fields: [storeId], references: [id])
  closedAt      DateTime?
  closedById    String?
  damaged       Boolean            @default(false)
  /// the courier's return fee, and what we claim from them for a lost parcel (paisa)
  courierCharge Int                @default(0)
  claimAmount   Int                @default(0)
  note          String             @default("")

  @@index([state, startedAt])
  @@index([startedAt])
}

// ---------- People: rosters (Phase 16a) ----------

/// One planned shift: a person at a location on a Nepal date, start to end (same day). One per person per day.
model RosterShift {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  /// Nepal calendar date YYYY-MM-DD, and times "HH:MM" Nepal time
  date        String
  start       String
  end         String
  createdById String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  swaps     ShiftSwap[] @relation("SwapShift")
  swapsBack ShiftSwap[] @relation("SwapBack")
  absence   Absence?

  @@unique([userId, date])
  @@index([storeId, date])
}

/// A location's week (from its first day): staff see the shifts once it's published.
model RosterWeek {
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  weekStart     String
  publishedAt   DateTime
  publishedById String
  /// last edit to the week's shifts (added, changed or removed): after publishedAt means staff see an old plan
  changedAt     DateTime?

  @@id([storeId, weekStart])
}

/// Public holidays (set by the owner each year; the government announces them).
model Holiday {
  date      String   @id
  name      String
  createdAt DateTime @default(now())
}

// ---------- Online size exchanges (Phase 17a) ----------

enum ExchangeStatus {
  OPEN // replacement on its way; the old items aren't back yet
  DONE // old items received back
  CANCELLED // the replacement never reached the customer: they keep the original
}

/// A delivered online order's items swapped for other sizes: a free replacement order goes out, the courier
/// collects the old items at the door, and they're received back as a zero-refund return.
model Exchange {
  id            String         @id @default(cuid())
  number        Int            @unique @default(autoincrement())
  orderId       String
  order         Order          @relation("ExchangeFrom", fields: [orderId], references: [id])
  replacementId String         @unique
  replacement   Order          @relation("ExchangeReplacement", fields: [replacementId], references: [id])
  reason        String
  requestedBy   String
  status        ExchangeStatus @default(OPEN)
  /// the zero-refund return recorded when the old items arrive
  returnId      String?        @unique
  return        Return?        @relation(fields: [returnId], references: [id])
  createdAt     DateTime       @default(now())
  closedAt      DateTime?
  items         ExchangeItem[]

  @@index([orderId])
  @@index([status, createdAt])
}

model ExchangeItem {
  id           String    @id @default(cuid())
  exchangeId   String
  exchange     Exchange  @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id])
  quantity     Int
  newVariantId String

  @@index([orderItemId])
}

enum SwapStatus {
  OFFERED // waiting for the colleague
  ACCEPTED // colleague said yes; waiting for a manager
  APPROVED // done: the shifts changed hands
  DECLINED // colleague said no
  REJECTED // manager said no
  CANCELLED // withdrawn, or no longer possible (shift changed or passed)
}

/// A published shift handed to a colleague (give away) or traded for one of theirs (swap). Colleague accepts,
/// a manager at that location approves; the shifts change hands only then.
model ShiftSwap {
  id           String       @id @default(cuid())
  shiftId      String
  shift        RosterShift  @relation("SwapShift", fields: [shiftId], references: [id], onDelete: Cascade)
  fromUserId   String
  fromUser     User         @relation("SwapFrom", fields: [fromUserId], references: [id])
  toUserId     String
  toUser       User         @relation("SwapTo", fields: [toUserId], references: [id])
  /// a swap: the colleague's shift the requester takes in return (null = give away)
  backShiftId  String?
  backShift    RosterShift? @relation("SwapBack", fields: [backShiftId], references: [id], onDelete: Cascade)
  note         String       @default("")
  status       SwapStatus   @default(OFFERED)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String       @default("")
  createdAt    DateTime     @default(now())

  @@index([status, createdAt])
  @@index([toUserId, status])
  @@index([shiftId])
}

// ---------- Markdowns and price events (Phase 18a) ----------

enum PriceEventStatus {
  DRAFT
  SCHEDULED // starts by itself at startsAt
  LIVE // prices are marked down now
  ENDED // prices put back
  CANCELLED
}

/// A sale (Dashain, end of season, clearance): products marked down from startsAt, back at endsAt (or never).
model PriceEvent {
  id          String           @id @default(cuid())
  number      Int              @unique @default(autoincrement())
  name        String
  startsAt    DateTime
  /// null = a permanent markdown (clearance): prices stay down
  endsAt      DateTime?
  status      PriceEventStatus @default(DRAFT)
  createdById String
  createdAt   DateTime         @default(now())
  startedAt   DateTime?
  endedAt     DateTime?
  items       PriceEventItem[]

  @@index([status, startsAt])
}

model PriceEventItem {
  id                String     @id @default(cuid())
  eventId           String
  event             PriceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  productId         String
  product           Product    @relation(fields: [productId], references: [id])
  /// sale price (paisa)
  newPrice          Int
  /// what the product cost on the shelf before (taken when the event starts), to put back at the end
  originalPrice     Int?
  originalCompareAt Int?
  /// set when the price couldn't be put back because someone changed it during the event
  restoreSkipped    Boolean    @default(false)

  @@unique([eventId, productId])
  @@index([productId])
}

/// "Text me if the price drops": fires once, when the product's price goes below what it was when asked.
model PriceAlert {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  phone      String
  userId     String?
  /// the price when they asked (paisa)
  price      Int
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([productId, phone])
  @@index([productId, notifiedAt])
}

// ---------- Damaged stock register (Phase 19a) ----------

enum DamageKind {
  IN // came back damaged (store return, exchange, parcel back, staff found it)
  REPAIRED // fixed: back on sale
  WRITTEN_OFF // thrown away or given away
  TO_SUPPLIER // sent back to the supplier for a credit
}

/// Append-only: damaged units in (+) and out (−) per location and size. The balance is what's in the back room.
model DamageEntry {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id])
  variantId      String
  variant        Variant         @relation(fields: [variantId], references: [id])
  kind           DamageKind
  /// + for IN, − for the rest
  quantity       Int
  /// cost of one unit when it came in (from the sale, else the size's cost)
  unitCost       Int?
  /// where it came from or went: "Store return R12", "EX-3", "AS000123 back from courier"
  source         String
  note           String          @default("")
  supplierId     String?
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  /// for TO_SUPPLIER: what we expect back, and when finance saw it arrive
  creditExpected Int?
  creditReceived Int?
  creditAt       DateTime?
  creditNoteId   String?
  creditNote     SupplierCredit? @relation(fields: [creditNoteId], references: [id])
  createdById    String?
  createdAt      DateTime        @default(now())

  @@index([storeId, variantId])
  @@index([kind, createdAt])
  @@index([supplierId, kind])
}

// ---------- Supplier credit notes (Phase 19b) ----------

/// A supplier's credit note (goods returned, damaged stock, a price correction): it settles open bills like a
/// payment with no money, and what isn't used is credit for later bills. Its VAT reduces input VAT.
model SupplierCredit {
  id          String             @id @default(cuid())
  number      Int                @unique @default(autoincrement())
  supplierId  String
  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  /// the supplier's own credit note number
  reference   String
  date        DateTime
  /// total credit in paisa, VAT included, and the VAT part
  amount      Int
  vatAmount   Int                @default(0)
  /// not yet set against a bill
  unallocated Int
  reason      String
  voidedAt    DateTime?
  voidReason  String?
  createdById String
  createdAt   DateTime           @default(now())
  allocations CreditAllocation[]
  damage      DamageEntry[]

  @@unique([supplierId, reference])
  @@index([supplierId, date])
  @@index([date])
}

model CreditAllocation {
  creditId String
  credit   SupplierCredit @relation(fields: [creditId], references: [id])
  billId   String
  bill     SupplierBill   @relation(fields: [billId], references: [id])
  amount   Int

  @@id([creditId, billId])
}

// ---------- Training: standard operating procedures (Phase 22a) ----------

enum SopArea {
  SALES
  CASH
  FULFILMENT
  STOCK
  CUSTOMERS
  PEOPLE
}

/// How we do something (opening the shop, cash at closing, packing an order), and who must read and sign it.
/// A significant change raises the version: everyone signs again.
model Sop {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  area        SopArea
  /// roles that must sign it (CASHIER, STAFF, MANAGER, ADMIN)
  roles       String[]
  /// plain text: "## " headings, "- " points, "1. " steps
  body        String
  version     Int          @default(1)
  active      Boolean      @default(true)
  updatedById String
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())
  signoffs    SopSignoff[]

  @@index([active, area])
}

/// "I've read this and will follow it", for one version.
model SopSignoff {
  sopId    String
  sop      Sop      @relation(fields: [sopId], references: [id], onDelete: Cascade)
  userId   String
  version  Int
  signedAt DateTime @default(now())

  @@id([sopId, userId])
  @@index([userId])
}

/// Recommendation links, rebuilt nightly by the `recommend.build` job (lib/recommend.ts): each product's best
/// partners from real orders (BOUGHT_WITH: association rules) and most similar products (SIMILAR). Pages read
/// these instead of computing them, so a product page stays fast at any catalogue size.
model ProductLink {
  productId String
  otherId   String
  kind      LinkKind
  score     Float
  /// orders containing both (BOUGHT_WITH only)
  support   Int      @default(0)
  updatedAt DateTime @default(now())

  @@id([productId, kind, otherId])
  @@index([productId, kind, score])
}

enum LinkKind {
  BOUGHT_WITH
  SIMILAR
}

/// A one-time link for a new team member to set their own password (the owner never knows it). Only a hash of
/// the token is stored; the link works once and expires.
model StaffInvite {
  id          String    @id @default(cuid())
  /// INVITE: a new team member sets their first password; RESET: anyone sets a new one (sent by customer care)
  purpose     String    @default("INVITE")
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// One-time sign-in and reset codes sent to a phone (or shown on screen in test mode, never on production).
/// Only a hash is stored; a code expires after 10 minutes and allows 5 tries.
model LoginCode {
  id        String    @id @default(cuid())
  /// the phone number (98XXXXXXXX) or email it was sent to
  target    String
  /// LOGIN or RESET
  purpose   String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([target, purpose, createdAt])
}
