DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/asson?schema=public"
# Generate with: openssl rand -hex 32
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Database connections per app instance (default 20). Lower it behind PgBouncer.
# DB_POOL_SIZE=20

# Scheduled jobs: send/retry customer SMS (/api/cron/notifications every 1–5 min)
# and release unpaid online orders (/api/cron/payments) — call with Authorization: Bearer $CRON_SECRET
CRON_SECRET=""
# SMS gateway for customer notifications (unset in production = messages queue until one is connected)
# NOTIFY_SMS_PROVIDER=""

# "Continue with Google" on the sign-in page (off until both are set). Create a free OAuth client in Google Cloud
# Console (type: Web application), authorised redirect URI: <site>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# One-time sign-in codes are sent by SMS once NOTIFY_SMS_PROVIDER is a real gateway. Until then production offers
# no codes (password only); staging and development show the code on screen. AUTH_CODES_TEST=1 forces that test
# mode (the E2E tests use it). NEVER set it on production.
# AUTH_CODES_TEST=""
